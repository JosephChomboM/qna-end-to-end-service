# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# --- Vector store ---
DATABASE_URL=postgresql://localhost:5432/qna-database

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=<your-chat-deployment-name>
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=<your-embedding-deployment-name>

# Must match the embedding model's output dimension
# (text-embedding-3-small = 1536, text-embedding-3-large = 3072, ada-002 = 1536)
EMBEDDING_DIM=1536

# --- Public-demo guards (optional) ---
RATE_LIMIT_PER_MINUTE=10     # per client IP, on /query
RATE_LIMIT_PER_DAY=300       # whole service, on /query
# If set, POST /ingest requires header  X-Admin-Token: <this value>
ADMIN_TOKEN=

# --- Retrieval / chunking (tuned in Phase 7) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4

# --- Langfuse (Phase 8) — optional live tracing of /query. Leave blank to
# disable. Get keys from your Langfuse project settings. ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
